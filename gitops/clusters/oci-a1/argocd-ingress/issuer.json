{
  "apiVersion": "cert-manager.io/v1",
  "kind": "ClusterIssuer",
  "metadata": {
    "annotations": {
      "argocd.argoproj.io/sync-wave": "0"
    },
    "name": "argocd-cloudflare"
  },
  "spec": {
    "acme": {
      "privateKeySecretRef": {
        "name": "argocd-acme-account"
      },
      "server": "https://acme-v02.api.letsencrypt.org/directory",
      "solvers": [
        {
          "dns01": {
            "cloudflare": {
              "apiTokenSecretRef": {
                "key": "api-token",
                "name": "cloudflare-dns-api-token"
              }
            }
          },
          "selector": {
            "dnsNames": [
              "argo.rvkang.app"
            ]
          }
        }
      ]
    }
  }
}
