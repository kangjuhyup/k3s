{
  "apiVersion": "cert-manager.io/v1",
  "kind": "Certificate",
  "metadata": {
    "annotations": {
      "argocd.argoproj.io/sync-wave": "10"
    },
    "name": "argocd-server",
    "namespace": "argocd"
  },
  "spec": {
    "dnsNames": [
      "argo.rvkang.app"
    ],
    "issuerRef": {
      "group": "cert-manager.io",
      "kind": "ClusterIssuer",
      "name": "argocd-cloudflare"
    },
    "privateKey": {
      "algorithm": "RSA",
      "rotationPolicy": "Always",
      "size": 2048
    },
    "secretName": "argocd-server-tls"
  }
}
