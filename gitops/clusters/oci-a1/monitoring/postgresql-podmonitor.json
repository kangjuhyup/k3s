{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "PodMonitor",
  "metadata": {
    "labels": {
      "release": "monitoring"
    },
    "name": "postgresql",
    "namespace": "monitoring"
  },
  "spec": {
    "namespaceSelector": {
      "matchNames": [
        "databases"
      ]
    },
    "podMetricsEndpoints": [
      {
        "interval": "30s",
        "port": "metrics"
      }
    ],
    "selector": {
      "matchLabels": {
        "cnpg.io/cluster": "shared-postgres"
      }
    }
  }
}
