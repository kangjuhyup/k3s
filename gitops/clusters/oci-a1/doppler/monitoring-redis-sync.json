{
  "apiVersion": "secrets.doppler.com/v1alpha1",
  "kind": "DopplerSecret",
  "metadata": {
    "annotations": {
      "argocd.argoproj.io/sync-wave": "20"
    },
    "name": "monitoring-redis",
    "namespace": "doppler-operator-system"
  },
  "spec": {
    "config": "prd",
    "host": "https://api.doppler.com",
    "managedSecret": {
      "name": "redis-metrics",
      "namespace": "monitoring",
      "type": "Opaque"
    },
    "processors": {
      "REDIS_HOST": {
        "asName": "master-host",
        "type": "plain"
      },
      "REDIS_OPERATIONS_TLS_CERT": {
        "asName": "tls.crt",
        "type": "plain"
      },
      "REDIS_OPERATIONS_TLS_KEY": {
        "asName": "tls.key",
        "type": "plain"
      },
      "REDIS_PORT": {
        "asName": "port",
        "type": "plain"
      },
      "REDIS_PROBE_PASSWORD": {
        "asName": "password",
        "type": "plain"
      },
      "REDIS_PROBE_USERNAME": {
        "asName": "username",
        "type": "plain"
      },
      "REDIS_REPLICA_HOST": {
        "asName": "replica-host",
        "type": "plain"
      },
      "REDIS_TLS_CA_CERT": {
        "asName": "ca.crt",
        "type": "plain"
      }
    },
    "project": "infrastructure",
    "resyncSeconds": 120,
    "secrets": [
      "REDIS_HOST",
      "REDIS_OPERATIONS_TLS_CERT",
      "REDIS_OPERATIONS_TLS_KEY",
      "REDIS_PORT",
      "REDIS_PROBE_PASSWORD",
      "REDIS_PROBE_USERNAME",
      "REDIS_REPLICA_HOST",
      "REDIS_TLS_CA_CERT"
    ],
    "tokenSecret": {
      "name": "doppler-auth-infrastructure-prd",
      "namespace": "doppler-operator-system"
    },
    "verifyTLS": true
  }
}
