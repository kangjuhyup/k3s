{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "shared-redis-replica",
    "namespace": "databases"
  },
  "spec": {
    "ports": [
      {
        "name": "redis",
        "port": 6379,
        "targetPort": "redis"
      }
    ],
    "selector": {
      "app.kubernetes.io/component": "replica",
      "app.kubernetes.io/name": "shared-redis"
    },
    "type": "ClusterIP"
  }
}
