             "REDIS_TLS_CA_CERT": "ca.crt", "REDIS_OPERATIONS_TLS_CERT": "tls.crt", "REDIS_OPERATIONS_TLS_KEY": "tls.key"}
  }, {
    "name": "monitoring-grafana", "project": "infrastructure", "config": "prd",
